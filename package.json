{
  "name": "globestudio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "sitemap": "node scripts/generate-sitemap.js",
    "og:generate": "node scripts/generate-og-images.js",
    "check:bundle": "node scripts/check-bundle-size.js",
    "check": "npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "dotted-map": "^3.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "world-countries": "^5.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.11.4",
    "jsdom": "^29.1.1",
    "satori": "^0.26.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
