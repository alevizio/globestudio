# ── Pre-launch teaser ───────────────────────────────────────────────
# Set VITE_TEASER=0 (1 = teaser). With 1, every route shows the
# coming-soon teaser + waitlist (the pre-launch Vercel deploy). At launch
# set 0 on Production and redeploy; the value is baked in at build time.
# Visit any URL with ?preview to bypass the teaser for team previews.
VITE_TEASER=0

# ── Waitlist storage for /api/subscribe (pick ONE) ──────────────────
# First-party: Vercel Blob. Stores one PRIVATE object per email; export
# at launch with `list({ prefix: "waitlist/" })`. Auto-injected when you
# create a Blob store and link it to the project — don't set by hand.
# BLOB_READ_WRITE_TOKEN=

# Alternative: Resend Audiences — lets you broadcast the launch email
# and handles unsubscribe/GDPR. Create an audience at resend.com.
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=

# Alternative: Vercel KV (Upstash). Auto-injected when you create a KV
# store and link it to the project — no need to set these by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
