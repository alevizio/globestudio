# ── Pre-launch teaser ───────────────────────────────────────────────
# Set VITE_TEASER=0 (1 = teaser). With 1, every route shows the
# coming-soon teaser + waitlist (the pre-launch Vercel deploy). At launch
# set 0 on Production and redeploy; the value is baked in at build time.
# Visit any URL with ?preview to bypass the teaser for team previews.
VITE_TEASER=0

# ── Waitlist (closed at launch) ─────────────────────────────────────
# /api/subscribe answers 410 Gone and reads none of the variables it
# used to (BLOB_READ_WRITE_TOKEN, RESEND_*, KV_*). The signups it saved
# under "waitlist/" in the project's Vercel Blob store were deleted on
# 5 Oct 2026, after the one launch email, as /privacy says.
